@Minder_backend_HostAddress = http://localhost:5000
@accessToken = replace-with-access-token

GET {{Minder_backend_HostAddress}}/todos/
Accept: application/json

###

GET {{Minder_backend_HostAddress}}/todos/1
Accept: application/json

###

### Create a project (requires the authenticated X-Access-Token cookie)
POST {{Minder_backend_HostAddress}}/api/Project
Content-Type: application/json

{
  "name": "Untitled Project"
}

### Update a project name
PUT {{Minder_backend_HostAddress}}/api/Project/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "name": "Renamed Project"
}

###

@projectId = 00000000-0000-0000-0000-000000000000
@stepId = 00000000-0000-0000-0000-000000000000

### Create a step (requires the authenticated X-Access-Token cookie)
POST {{Minder_backend_HostAddress}}/api/Project/{{projectId}}/steps
Content-Type: application/json
Cookie: X-Access-Token={{accessToken}}

{
  "title": "Untitled step",
  "description": "",
  "width": 120,
  "height": 60,
  "x": 0,
  "y": 0
}

### Get a step returned by the create request
GET {{Minder_backend_HostAddress}}/api/Project/{{projectId}}/steps/{{stepId}}
Accept: application/json
Cookie: X-Access-Token={{accessToken}}

###
